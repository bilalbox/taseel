{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"files": {
		"includes": ["src/**"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 25
					}
				}
			}
		}
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	}
}
